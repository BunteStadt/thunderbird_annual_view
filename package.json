{
  "name": "yearview",
  "version": "1.1.3",
  "description": "Calender Year View",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "test": "node --test && tsc -p tsconfig.json",
    "test:e2e:saas": "node test/e2e/saas-demo-playwright.mjs",
    "build:thunderbird": "vite build --config vite.thunderbird.config.mjs",
    "build:xpi": "assets/scripts/build-xpi.sh",
    "check:thunderbird": "assets/scripts/lint-thunderbird.sh",
    "build:saas": "vite build",
    "cf-typegen": "wrangler types worker-configuration.d.ts",
    "deploy:saas": "npm run build:saas && wrangler deploy",
    "dev": "vite",
    "dev:core": "vite --config vite.core.config.mjs",
    "dev:saas:full": "npm run build:saas && wrangler dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BunteStadt/thunderbird_annual_view.git"
  },
  "author": "Richard Pergens",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/BunteStadt/thunderbird_annual_view/issues"
  },
  "homepage": "https://github.com/BunteStadt/thunderbird_annual_view#readme",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "webext-linter": "https://codeload.github.com/thunderbird/webext-linter/tar.gz/fb6bc3f387d99d693a9c15dd618b29de3dd2289d",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wrangler": "^4.119.0"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.1",
    "@clerk/react": "^6.13.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "lucide-react": "^1.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}