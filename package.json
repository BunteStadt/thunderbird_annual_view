{
  "name": "yearview",
  "version": "1.1.3",
  "description": "Calender Year View",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "build:web": "vite build --mode web",
    "build:thunderbird": "vite build --mode thunderbird",
    "build:saas": "vite build --config vite.saas.config.ts",
    "cf-typegen": "wrangler types worker-configuration.d.ts",
    "deploy:saas": "npm run build:saas && wrangler deploy",
    "dev": "vite --config vite.saas.config.ts",
    "dev:web": "vite",
    "dev:saas": "vite --config vite.saas.config.ts",
    "dev:saas:full": "npm run build:saas && wrangler dev",
    "preview:saas": "vite preview --config vite.saas.config.ts",
    "typecheck:saas": "tsc -p tsconfig.saas.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BunteStadt/thunderbird_annual_view.git"
  },
  "author": "Richard Pergens",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/BunteStadt/thunderbird_annual_view/issues"
  },
  "homepage": "https://github.com/BunteStadt/thunderbird_annual_view#readme",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wrangler": "^4.119.0"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/supabase-js": "^2.112.2",
    "lucide-react": "^1.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "stripe": "^22.4.0"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}